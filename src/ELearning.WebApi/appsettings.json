{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "ELearning.API",
    "Audience": "ELearning.Client",
    "ExpiryMinutes": 60
  },
  "Redis": {
    "ConnectionString": "",
    "DefaultCacheTtlSeconds": 300,
    "CourseDetailTtlSeconds": 600,
    "AnalyticsTtlSeconds": 180,
    "LockTtlSeconds": 10,
    "IdempotencyTtlSeconds": 86400,
    "RateLimitWindowSeconds": 60
  },
  "Ai": {
    "Provider": "Local",
    "Model": "local-deterministic-v1",
    "BaseUrl": "https://api.openai.com/v1",
    "ChatModel": "",
    "TimeoutSeconds": 30,
    "MaxOutputTokens": 1200,
    "MaxRetries": 2,
    "FallbackToLocal": true,
    "QuizQuestionPromptVersion": "quiz-question-generator-v1",
    "EssayGradingPromptVersion": "essay-grading-v1",
    "LearningPathPromptVersion": "learning-path-generator-v1",
    "RagChatPromptVersion": "rag-learning-assistant-v1",
    "RagEmbeddingProvider": "Local",
    "RagEmbeddingBaseUrl": "",
    "RagEmbeddingModel": "",
    "RagEmbeddingDimensions": 384,
    "RagEmbeddingTimeoutSeconds": 30,
    "RagEmbeddingMaxRetries": 2,
    "RagMaxRetrievedChunks": 4,
    "RagMinSimilarity": 0.05,
    "RagMaxContextCharacters": 2400,
    "RagCandidateMultiplier": 8,
    "RagReindexPollSeconds": 5,
    "MaxSourceCharacters": 12000
  },
  "Cors": {
    "AllowedOrigins": ""
  },
  "Security": {
    "EnableSecurityHeaders": true,
    "ValidateUnsafeRequestOrigins": true,
    "ContentSecurityPolicy": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'",
    "ReferrerPolicy": "no-referrer",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "HstsMaxAgeDays": 365
  },
  "Payments": {
    "Provider": "",
    "WebhookSecret": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
