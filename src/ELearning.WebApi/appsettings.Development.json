{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=elearning_dev;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Secret": "dev-secret-key-change-in-production-min-32-chars",
    "Issuer": "ELearning.API",
    "Audience": "ELearning.Client",
    "ExpiryMinutes": 60
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "DefaultCacheTtlSeconds": 300,
    "CourseDetailTtlSeconds": 600,
    "AnalyticsTtlSeconds": 180,
    "LockTtlSeconds": 10,
    "IdempotencyTtlSeconds": 86400,
    "RateLimitWindowSeconds": 60
  },
  "Ai": {
    "Provider": "Local",
    "Model": "local-deterministic-v1",
    "BaseUrl": "https://api.openai.com/v1",
    "ChatModel": "",
    "TimeoutSeconds": 30,
    "MaxOutputTokens": 1200,
    "MaxRetries": 2,
    "FallbackToLocal": true,
    "QuizQuestionPromptVersion": "quiz-question-generator-v1",
    "EssayGradingPromptVersion": "essay-grading-v1",
    "LearningPathPromptVersion": "learning-path-generator-v1",
    "RagChatPromptVersion": "rag-learning-assistant-v1",
    "RagMaxRetrievedChunks": 4,
    "RagMinSimilarity": 0.05,
    "MaxSourceCharacters": 12000
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:4200"
  },
  "Security": {
    "EnableSecurityHeaders": true,
    "ValidateUnsafeRequestOrigins": true,
    "ContentSecurityPolicy": "default-src 'self' http://localhost:4200 http://localhost:5000; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://localhost:4200 http://localhost:5000",
    "ReferrerPolicy": "no-referrer",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "HstsMaxAgeDays": 365
  },
  "Payments": {
    "Provider": "NoOp",
    "WebhookSecret": "dev-payments-webhook-secret-change-me"
  },
  "Seed": {
    "AdminEmail": "admin@localhost.local",
    "AdminPassword": "ChangeMe123!"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
